{
  "name": "info-revenue-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:collect": "tsx scripts/collect/collect-certifications.ts",
    "data:normalize": "tsx scripts/normalize/normalize-certifications.ts",
    "data:validate": "tsx scripts/validate/validate-certifications.ts",
    "data:publish": "tsx scripts/publish/publish-certifications.ts",
    "data:build": "npm run data:collect && npm run data:normalize && npm run data:validate && npm run data:publish",
    "build": "next build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.67.0",
    "vitest": "latest"
  }
}
